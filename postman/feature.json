    {
      "name": "Private",
      "item": [
        {
          "name": "Comment create",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Универсальные обёртки над pm.sendRequest, чтобы работать через async/await\r",
                  "const sendPost = (url, body) => new Promise((resolve, reject) => {\r",
                  "    pm.sendRequest({\r",
                  "        url: url,\r",
                  "        method: 'POST',\r",
                  "        header: { 'Content-Type': 'application/json' },\r",
                  "        body: { mode: 'raw', raw: JSON.stringify(body) }\r",
                  "    }, (err, res) => err ? reject(err) : resolve(res));\r",
                  "});\r",
                  "\r",
                  "const sendPatch = (url, body) => new Promise((resolve, reject) => {\r",
                  "    pm.sendRequest({\r",
                  "        url: url,\r",
                  "        method: 'PATCH',\r",
                  "        header: { 'Content-Type': 'application/json' },\r",
                  "        body: { mode: 'raw', raw: JSON.stringify(body) }\r",
                  "    }, (err, res) => err ? reject(err) : resolve(res));\r",
                  "});\r",
                  "\r",
                  "(async () => {\r",
                  "    const baseUrl = pm.collectionVariables.get(\"baseUrl\") || \"http://localhost:8080\";\r",
                  "    pm.collectionVariables.set(\"baseUrl\", baseUrl);\r",
                  "\r",
                  "    // Уникальный суффикс, чтобы данные не дублировались между запусками\r",
                  "    const stamp = Date.now();\r",
                  "\r",
                  "    try {\r",
                  "        // 1. Владелец события — он же будет автором комментариев\r",
                  "        let res = await sendPost(`${baseUrl}/admin/users`, {\r",
                  "            name: `Owner_${stamp}`,\r",
                  "            email: `owner_${stamp}@test.ru`\r",
                  "        });\r",
                  "        if (res.code !== 201) throw new Error(`Create owner failed: ${res.code} ${res.text()}`);\r",
                  "        const ownerId = res.json().id;\r",
                  "        pm.collectionVariables.set(\"userId\", ownerId);\r",
                  "        console.log(`✅ Owner created: id=${ownerId}`);\r",
                  "\r",
                  "        // 2. Второй пользователь — для проверки прав и 403/404\r",
                  "        res = await sendPost(`${baseUrl}/admin/users`, {\r",
                  "            name: `Other_${stamp}`,\r",
                  "            email: `other_${stamp}@test.ru`\r",
                  "        });\r",
                  "        if (res.code !== 201) throw new Error(`Create other user failed: ${res.code}`);\r",
                  "        const otherUserId = res.json().id;\r",
                  "        pm.collectionVariables.set(\"otherUserId\", otherUserId);\r",
                  "        console.log(`✅ Other user created: id=${otherUserId}`);\r",
                  "\r",
                  "        // 3. Категория для события\r",
                  "        res = await sendPost(`${baseUrl}/admin/categories`, {\r",
                  "            name: `Category_${stamp}`\r",
                  "        });\r",
                  "        if (res.code !== 201) throw new Error(`Create category failed: ${res.code}`);\r",
                  "        const categoryId = res.json().id;\r",
                  "        pm.collectionVariables.set(\"categoryId\", categoryId);\r",
                  "        console.log(`✅ Category created: id=${categoryId}`);\r",
                  "\r",
                  "        // 4. Событие, которое будет комментироваться\r",
                  "        res = await sendPost(`${baseUrl}/users/${ownerId}/events`, {\r",
                  "            annotation: \"Это тестовое событие для проверки функциональности комментариев\",\r",
                  "            category: categoryId,\r",
                  "            description: \"Подробное описание тестового события, созданного автоматически для Postman-тестов функциональности комментариев\",\r",
                  "            eventDate: \"2026-12-31 12:00:00\",\r",
                  "            location: { lat: 55.754167, lon: 37.62 },\r",
                  "            paid: false,\r",
                  "            participantLimit: 10,\r",
                  "            requestModeration: true,\r",
                  "            title: \"Тестовое событие для комментариев\"\r",
                  "        });\r",
                  "        if (res.code !== 201) throw new Error(`Create event failed: ${res.code} ${res.text()}`);\r",
                  "        const eventId = res.json().id;\r",
                  "        pm.collectionVariables.set(\"eventId\", eventId);\r",
                  "        console.log(`✅ Event created: id=${eventId}`);\r",
                  "\r",
                  "        // 5. Публикуем событие (иначе нельзя комментировать)\r",
                  "        res = await sendPatch(`${baseUrl}/admin/events/${eventId}`, {\r",
                  "            stateAction: \"PUBLISH_EVENT\"\r",
                  "        });\r",
                  "        if (res.code !== 200) throw new Error(`Publish event failed: ${res.code} ${res.text()}`);\r",
                  "        console.log(`✅ Event published: id=${eventId}`);\r",
                  "\r",
                  "        // 6. Второе событие для 409-тестов (своё событие пользователя)\r",
                  "        res = await sendPost(`${baseUrl}/users/${otherUserId}/events`, {\r",
                  "            annotation: \"Своё событие пользователя для проверки 409\",\r",
                  "            category: categoryId,\r",
                  "            description: \"Описание события, на которое пользователь не сможет оставить комментарий как автор\",\r",
                  "            eventDate: \"2026-12-31 14:00:00\",\r",
                  "            location: { lat: 55.75, lon: 37.62 },\r",
                  "            paid: false,\r",
                  "            participantLimit: 5,\r",
                  "            requestModeration: false,\r",
                  "            title: \"Своё событие пользователя\"\r",
                  "        });\r",
                  "        if (res.code === 201) {\r",
                  "            pm.collectionVariables.set(\"ownEventId\", res.json().id);\r",
                  "            console.log(`✅ Own event created: id=${res.json().id}`);\r",
                  "        }\r",
                  "\r",
                  "        // 7. Черновик для 409-теста «неопубликованное событие»\r",
                  "        res = await sendPost(`${baseUrl}/users/${ownerId}/events`, {\r",
                  "            annotation: \"Черновик события, который не опубликован\",\r",
                  "            category: categoryId,\r",
                  "            description: \"Описание черновика для проверки, что к неопубликованному событию нельзя оставлять комментарии\",\r",
                  "            eventDate: \"2026-12-31 16:00:00\",\r",
                  "            location: { lat: 55.75, lon: 37.62 },\r",
                  "            paid: false,\r",
                  "            participantLimit: 5,\r",
                  "            requestModeration: false,\r",
                  "            title: \"Черновик для 409-теста\"\r",
                  "        });\r",
                  "        if (res.code === 201) {\r",
                  "            pm.collectionVariables.set(\"unpublishedEventId\", res.json().id);\r",
                  "            console.log(`✅ Unpublished event created: id=${res.json().id}`);\r",
                  "        }\r",
                  "\r",
                  "        console.log(\"🎉 Setup completed successfully\");\r",
                  "    } catch (e) {\r",
                  "        console.error(\"❌ Setup error:\", e);\r",
                  "    }\r",
                  "})();"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has id, text, authorName, created\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json).to.have.property(\"id\");\r",
                  "    pm.expect(json).to.have.property(\"text\");\r",
                  "    pm.expect(json).to.have.property(\"authorName\");\r",
                  "    pm.expect(json).to.have.property(\"created\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Text matches request\", function () {\r",
                  "    pm.expect(pm.response.json().text).to.eql(\"Отличное событие, всем рекомендую!\");\r",
                  "});\r",
                  "\r",
                  "// Сохраняем id для следующих тестов\r",
                  "if (pm.response.code === 201) {\r",
                  "    pm.collectionVariables.set(\"commentId\", pm.response.json().id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
